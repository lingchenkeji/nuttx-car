# Add RFID module to CONFIGURED_APPS for registration (if NSH command is enabled)

ifneq ($(CONFIG_MYPROJECTS_MODULES_RFID_NSH),)
CONFIGURED_APPS += $(APPDIR)/myprojects/modules/rfid
endif
